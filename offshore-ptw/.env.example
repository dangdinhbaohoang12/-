# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_a_secret_service_role_key

# Server-only secrets. Generate long random values (min 32 chars) – the
# placeholders below are rejected at startup, deployment fails closed if you
# forget to replace them.
PTW_SESSION_SECRET=replace_with_a_long_random_session_secret
PTW_AUDIT_SECRET=replace_with_a_long_random_audit_secret

# One-time bootstrap account. These values are read only by the server.
# BOOTSTRAP_OIM_PIN must be 4-8 digits (validPin requires /^\d{4,8}$/).
# After the first login, change the bootstrap PIN and rotate/remove this secret.
BOOTSTRAP_OIM_USERNAME=replace_with_bootstrap_username
BOOTSTRAP_OIM_PIN=13579246
BOOTSTRAP_OIM_FULL_NAME=Replace With Bootstrap Full Name
BOOTSTRAP_OIM_PLATFORM_CODE=MT1
BOOTSTRAP_OIM_EMAIL=
BOOTSTRAP_OIM_PHONE=